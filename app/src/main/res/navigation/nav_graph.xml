<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/propertyListFragment">

    <fragment
        android:id="@+id/propertyListFragment"
        android:name="com.juanfbenitez.prueba.idealista.ui.list.PropertyListFragment"
        android:label="Property List"
        tools:layout="@layout/fragment_property_list">
        <action
            android:id="@+id/action_propertyListFragment_to_propertyDetailFragment"
            app:destination="@id/propertyDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/propertyDetailFragment"
        android:name="com.juanfbenitez.prueba.idealista.ui.detail.PropertyDetailFragment"
        android:label="Property Detail"
        tools:layout="@layout/fragment_property_detail">
        <argument
            android:name="propertyCode"
            app:argType="string" />
    </fragment>
</navigation>
