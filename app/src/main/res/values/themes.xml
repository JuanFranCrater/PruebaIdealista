<resources>

    <style name="Theme.PruebaIdealista" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/idealista_primary</item>
        <item name="colorPrimaryVariant">@color/idealista_primary_dark</item>
        <item name="colorOnPrimary">@color/idealista_black</item>
        <item name="colorSecondary">@color/idealista_secondary</item>
        <item name="colorSecondaryVariant">@color/idealista_secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/idealista_primary</item>
        <item name="colorError">@color/idealista_red</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:textColorPrimary">@color/idealista_black</item>
        <item name="android:textColorSecondary">@color/idealista_gray</item>
        <item name="android:statusBarColor">@color/idealista_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialCardViewStyle">@style/Widget.Idealista.CardView</item>
    </style>

    <style name="Widget.Idealista.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/idealista_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Idealista.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/idealista_primary</item>
        <item name="rippleColor">@color/idealista_primary_dark</item>
    </style>

    <style name="TextAppearance.Idealista.Price" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/idealista_black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Idealista.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/idealista_black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Idealista.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>